#!/usr/bin/env bash

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$script_dir/tmux-sessionizer-lib.sh"

# search for project directory
selected=$(
	{
		find ~/code ~/learning -mindepth 1 -maxdepth 1 -type d 
		printf '%s\n' ~/dotfiles
		printf '%s\n' ~/firstmate
	} | fzf)

# if we did not select a directory then exit
if [[ -z $selected ]]; then
	exit 0
fi

# tr finds characters in input and replaces them with corresponding character of output
# I.E. we replace . with _
session_name=$(basename "$selected" | tr . _)

# Ensure the target session exists (created detached so this works whether or
# not we currently have a client - e.g. when invoked from `tmux run-shell`,
# which has no controlling terminal and does NOT set $TMUX).
if ! tmux has-session -t "$session_name" 2> /dev/null; then
# Note: If has-session is running on a session that doesn't exist it will put a message to sout
# we use the 2> to pipe that into the garbage can '/dev/null'
	tmux new-session -s "$session_name" -c "$selected" -d
	apply_session_config "$session_name" "$selected"
fi

# Now hand off to the session. The right verb depends on whether we already
# have a tmux client attached to this terminal - NOT on $TMUX alone:
#   - $TMUX set  -> we're inside a tmux client: switch it.
#   - $TMUX unset but there IS an attached client -> we're being driven from
#     `run-shell`/a keybinding with no TTY of our own: switch that client
#     instead of trying to attach (attach would fail "not a terminal").
#   - $TMUX unset and NO attached client -> we're a real standalone terminal:
#     attach normally.
if [[ -n $TMUX ]]; then
	tmux switch-client -t "$session_name"
elif tmux list-clients 2> /dev/null | grep -q .; then
	tmux switch-client -t "$session_name"
else
	tmux attach-session -t "$session_name"
fi

# Scenarios
#
# Not in tmux && tmux isn't running -> no sessions exist
# Not in tmux && tmux is running && session exists
# Not in tmux && tmux is running && session does not exist
# In tmux && session exists -> tmux is running
# in tmux && session does not exist -> tmux is running
