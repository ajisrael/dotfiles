eval "$(/usr/local/bin/brew shellenv)"

# Add Visual Studio Code (code)
export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"

# nvm's lazy-load shims (nvm/node/npm/npx, NVM_DIR) live in personal.zsh,
# not here - personal.zsh is sourced by every interactive shell (.zshrc),
# while this file only loads for login shells. __nvmrc_hook (also in
# personal.zsh) calls `nvm use` on every cd, including in non-login
# interactive shells (e.g. treehouse's worktree subshell) - defining the
# shims here left those with __nvmrc_hook but no nvm shim to call,
# producing "command not found: nvm".

# Setting PATH for Python 3.13
# The original version is saved in .zprofile.pysave
PATH="/Library/Frameworks/Python.framework/Versions/3.13/bin:${PATH}"
export PATH
