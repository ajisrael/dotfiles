# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

# Optional per-machine hook, before oh-my-zsh loads: a machine whose
# oh-my-zsh/theme/plugins live elsewhere (e.g. distro packages) overrides
# ZSH, ZSH_CUSTOM, ZSH_CACHE_DIR, plugins, ... here. Absent on the Mac.
[[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/pre-omz.zsh" ]] && source "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/pre-omz.zsh"

source $ZSH/oh-my-zsh.sh

# User configuration - personal.zsh next to this file's real location (the
# repo checkout, or a copy vendored elsewhere), falling back to the Mac's
# checkout when ~/.zshrc is a plain (merged) file rather than a symlink.
__zshrc_dir="${${(%):-%x}:A:h}"
if [[ -r "$__zshrc_dir/personal.zsh" ]]; then
  source "$__zshrc_dir/personal.zsh"
else
  source "$HOME/dotfiles/home/zsh/personal.zsh"
fi
unset __zshrc_dir

# Optional per-machine overlay, after the shared config (absent on the Mac).
[[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/local.zsh" ]] && source "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/local.zsh"

#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
# Redirected to /dev/null: sdkman-init.sh's sdkman_auto_env runs once,
# unconditionally, the moment it's sourced (not just registered as a
# chpwd hook for later) - so a project with a pre-existing .sdkmanrc
# (e.g. hybris-workspace) prints "Using java version ... in this shell"
# during this exact source call, which Powerlevel10k's instant prompt
# flags as stray console output during zsh init. Only silences this one
# startup announcement; later cd-triggered switches still print normally,
# since those happen after the prompt is already up.
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh" > /dev/null
